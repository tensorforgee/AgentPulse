generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

model User {
  id                          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                       String               @unique(map: "users_email_key") @db.VarChar(320)
  passwordHash                String               @map("password_hash") @db.Text
  refreshTokenHash            String?              @map("refresh_token_hash") @db.Text
  displayName                 String?              @map("display_name") @db.Text
  createdAt                   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships                 OrganizationMember[]
  createdOrganizationInvites  OrganizationInvite[] @relation("OrganizationInviteCreator")
  acceptedOrganizationInvites OrganizationInvite[] @relation("OrganizationInviteAcceptor")

  @@map("users")
}

model Organization {
  id                            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                          String                @db.Text
  slug                          String                @unique(map: "organizations_slug_key") @db.VarChar(100)
  plan                          BillingPlan           @default(free)
  subscriptionStatus            SubscriptionStatus    @default(none) @map("subscription_status")
  billingProvider               String?               @map("billing_provider") @db.Text
  externalBillingCustomerId     String?               @map("external_billing_customer_id") @db.Text
  externalBillingSubscriptionId String?               @map("external_billing_subscription_id") @db.Text
  billingPeriodStartedAt        DateTime?             @map("billing_period_started_at") @db.Timestamptz(6)
  billingPeriodEndsAt           DateTime?             @map("billing_period_ends_at") @db.Timestamptz(6)
  cancelAtPeriodEnd             Boolean               @default(false) @map("cancel_at_period_end")
  createdAt                     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships                   OrganizationMember[]
  projects                      Project[]
  billingWebhookEvents          BillingWebhookEvent[]
  invites                       OrganizationInvite[]

  @@unique([billingProvider, externalBillingCustomerId], map: "organizations_billing_provider_customer_id_key")
  @@unique([billingProvider, externalBillingSubscriptionId], map: "organizations_billing_provider_subscription_id_key")
  @@map("organizations")
}

model BillingWebhookEvent {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider        String        @db.Text
  externalEventId String        @map("external_event_id") @db.Text
  eventType       String        @map("event_type") @db.Text
  organizationId  String?       @map("org_id") @db.Uuid
  processedAt     DateTime      @default(now()) @map("processed_at") @db.Timestamptz(6)
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@unique([provider, externalEventId], map: "billing_webhook_events_provider_external_id_key")
  @@index([organizationId, processedAt], map: "billing_webhook_events_org_id_processed_at_idx")
  @@map("billing_webhook_events")
}

model OrganizationMember {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("org_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  role           String       @default("member") @db.Text
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId], map: "org_members_org_id_user_id_key")
  @@index([userId], map: "org_members_user_id_idx")
  @@map("org_members")
}

model OrganizationInvite {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String       @map("org_id") @db.Uuid
  email            String       @db.VarChar(320)
  role             String       @default("member") @db.Text
  tokenDigest      String       @unique(map: "organization_invites_token_digest_key") @map("token_digest") @db.Char(64)
  expiresAt        DateTime     @map("expires_at") @db.Timestamptz(6)
  acceptedAt       DateTime?    @map("accepted_at") @db.Timestamptz(6)
  revokedAt        DateTime?    @map("revoked_at") @db.Timestamptz(6)
  createdByUserId  String       @map("created_by_user_id") @db.Uuid
  acceptedByUserId String?      @map("accepted_by_user_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy        User         @relation("OrganizationInviteCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  acceptedBy       User?        @relation("OrganizationInviteAcceptor", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, email], map: "organization_invites_org_id_email_key")
  @@index([organizationId, expiresAt], map: "organization_invites_org_id_expires_at_idx")
  @@map("organization_invites")
}

model Project {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("org_id") @db.Uuid
  name           String       @db.Text
  slug           String       @db.VarChar(100)
  description    String?      @db.Text
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  apiKeys        ApiKey[]
  alertRules     AlertRule[]
  alertEvents    AlertEvent[]
  traces         Trace[]

  @@unique([organizationId, slug], map: "projects_org_id_slug_key")
  @@index([organizationId], map: "projects_org_id_idx")
  @@map("projects")
}

model AlertRule {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String       @map("project_id") @db.Uuid
  name      String       @db.Text
  type      String       @db.Text
  threshold Decimal      @db.Decimal(18, 8)
  enabled   Boolean      @default(true)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  events    AlertEvent[]

  @@index([projectId], map: "alert_rules_project_id_idx")
  @@map("alert_rules")
}

model AlertEvent {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId           String     @map("project_id") @db.Uuid
  alertRuleId         String?    @map("alert_rule_id") @db.Uuid
  traceId             String     @map("trace_id") @db.Uuid
  ruleName            String     @map("rule_name") @db.Text
  ruleType            String     @map("rule_type") @db.Text
  threshold           Decimal    @db.Decimal(18, 8)
  observedValue       Decimal    @map("observed_value") @db.Decimal(18, 8)
  windowStartedAt     DateTime   @map("window_started_at") @db.Timestamptz(6)
  windowEndedAt       DateTime   @map("window_ended_at") @db.Timestamptz(6)
  deliveryStatus      String     @default("pending") @map("delivery_status") @db.Text
  deliveryAttemptedAt DateTime?  @map("delivery_attempted_at") @db.Timestamptz(6)
  deliveryError       String?    @map("delivery_error") @db.Text
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  project             Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  alertRule           AlertRule? @relation(fields: [alertRuleId], references: [id], onDelete: SetNull)
  trace               Trace      @relation(fields: [traceId], references: [id], onDelete: Cascade)

  @@unique([alertRuleId, traceId], map: "alert_events_alert_rule_id_trace_id_key")
  @@index([projectId, createdAt(sort: Desc)], map: "alert_events_project_id_created_at_idx")
  @@index([traceId], map: "alert_events_trace_id_idx")
  @@map("alert_events")
}

model ApiKey {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId  String    @map("project_id") @db.Uuid
  name       String    @db.Text
  prefix     String    @db.VarChar(16)
  hashedKey  String    @unique(map: "api_keys_hashed_key_key") @map("hashed_key") @db.Text
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId], map: "api_keys_project_id_idx")
  @@index([prefix], map: "api_keys_prefix_idx")
  @@map("api_keys")
}

model Trace {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId    String       @map("project_id") @db.Uuid
  agentName    String       @map("agent_name") @db.Text
  name         String?      @db.Text
  status       String       @default("running") @db.Text
  startedAt    DateTime     @map("started_at") @db.Timestamptz(6)
  endedAt      DateTime?    @map("ended_at") @db.Timestamptz(6)
  durationMs   BigInt?      @map("duration_ms") @db.BigInt
  inputTokens  BigInt       @default(0) @map("input_tokens") @db.BigInt
  outputTokens BigInt       @default(0) @map("output_tokens") @db.BigInt
  totalTokens  BigInt       @default(0) @map("total_tokens") @db.BigInt
  totalCost    Decimal      @default(0) @map("total_cost") @db.Decimal(18, 8)
  metadata     Json         @default("{}") @db.JsonB
  errorType    String?      @map("error_type") @db.Text
  errorMessage String?      @map("error_message") @db.Text
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  spans        Span[]
  alertEvents  AlertEvent[]

  @@index([projectId, startedAt(sort: Desc), id(sort: Desc)], map: "traces_project_id_started_at_id_idx")
  @@index([projectId, status, startedAt(sort: Desc), id(sort: Desc)], map: "traces_project_id_status_started_at_id_idx")
  @@map("traces")
}

model Span {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  traceId       String    @map("trace_id") @db.Uuid
  parentSpanId  String?   @map("parent_span_id") @db.Uuid
  name          String    @db.Text
  spanType      String    @default("custom") @map("span_type") @db.Text
  status        String    @default("running") @db.Text
  startedAt     DateTime  @map("started_at") @db.Timestamptz(6)
  endedAt       DateTime? @map("ended_at") @db.Timestamptz(6)
  latencyMs     BigInt?   @map("latency_ms") @db.BigInt
  input         Json?     @db.JsonB
  output        Json?     @db.JsonB
  provider      String?   @db.Text
  model         String?   @db.Text
  inputTokens   BigInt    @default(0) @map("input_tokens") @db.BigInt
  outputTokens  BigInt    @default(0) @map("output_tokens") @db.BigInt
  estimatedCost Decimal   @default(0) @map("estimated_cost") @db.Decimal(18, 8)
  attributes    Json      @default("{}") @db.JsonB
  errorType     String?   @map("error_type") @db.Text
  errorMessage  String?   @map("error_message") @db.Text
  errorStack    String?   @map("error_stack") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  trace         Trace     @relation(fields: [traceId], references: [id], onDelete: Cascade)
  /// The migration uses PostgreSQL's column-list SET NULL so deleting a parent
  /// clears only parent_span_id and never the required tenant-scoped trace_id.
  parent        Span?     @relation("SpanHierarchy", fields: [traceId, parentSpanId], references: [traceId, id], onDelete: SetNull)
  children      Span[]    @relation("SpanHierarchy")

  @@unique([traceId, id], map: "spans_trace_id_id_key")
  @@index([traceId, startedAt, id], map: "spans_trace_id_started_at_id_idx")
  @@index([parentSpanId], map: "spans_parent_span_id_idx")
  @@map("spans")
}

enum BillingPlan {
  free
  pro

  @@map("billing_plan")
}

enum SubscriptionStatus {
  none
  trialing
  active
  past_due
  canceled

  @@map("subscription_status")
}
