POSTGRES_DB=agentpulse
POSTGRES_USER=agentpulse
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
DATABASE_URL=postgresql://agentpulse:replace-with-a-long-url-safe-password@postgres:5432/agentpulse?schema=public

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret

# Public DNS names. Point A records (and AAAA only with working IPv6) at the host.
WEB_DOMAIN=app.agentpulse.example.com
API_DOMAIN=api.agentpulse.example.com

# Direct client -> Caddy -> API is exactly one trusted proxy hop.
TRUST_PROXY_HOPS=1

# Optional alert delivery and AI RCA. Leave unset/empty to disable gracefully.
ALERT_WEBHOOK_URLS_JSON={}
ALERT_WEBHOOK_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
RCA_PROVIDER_API_KEY=
RCA_PROVIDER_MODEL=
RCA_PROVIDER_BASE_URL=https://api.openai.com/v1

# Optional Stripe subscriptions. Configure all three together to enable billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Optional rate-limit overrides. These match the API defaults.
RATE_LIMIT_AUTH_SIGNUP_MAX=5
RATE_LIMIT_AUTH_LOGIN_MAX=10
RATE_LIMIT_AUTH_REFRESH_MAX=30
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_API_KEY_INVALID_MAX=30
RATE_LIMIT_API_KEY_INVALID_WINDOW_MS=60000
RATE_LIMIT_INGEST_MAX=600
RATE_LIMIT_INGEST_WINDOW_MS=60000
RATE_LIMIT_RCA_MAX=10
RATE_LIMIT_RCA_WINDOW_MS=60000
RATE_LIMIT_MAX_BUCKETS=10000
