{
  "name": "@agentpulse/sdk",
  "version": "0.0.1",
  "private": true,
  "description": "Minimal TypeScript SDK for AgentPulse manual instrumentation",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "prebuild": "pnpm --filter @agentpulse/shared build",
    "build": "tsc -p tsconfig.json",
    "typecheck": "pnpm --filter @agentpulse/shared build && tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test test/*.test.js"
  },
  "dependencies": {
    "@agentpulse/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
