{
  "name": "@agentpulse/sdk",
  "version": "0.0.1",
  "description": "TypeScript SDK for AgentPulse manual instrumentation",
  "keywords": [
    "ai",
    "agents",
    "observability",
    "telemetry",
    "tracing"
  ],
  "homepage": "https://github.com/tensorforgee/AgentPulse#readme",
  "bugs": {
    "url": "https://github.com/tensorforgee/AgentPulse/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tensorforgee/AgentPulse.git",
    "directory": "packages/sdk"
  },
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "pnpm --filter @agentpulse/shared build",
    "build": "tsup src/index.ts --format cjs,esm --dts --dts-resolve --clean --target node18",
    "prepack": "pnpm run build",
    "typecheck": "pnpm --filter @agentpulse/shared build && tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test test/*.test.js"
  },
  "devDependencies": {
    "@agentpulse/shared": "workspace:*",
    "tsup": "^8.5.0",
    "typescript": "^5.7.3"
  }
}
